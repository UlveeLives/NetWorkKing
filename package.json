{
  "name": "networkking",
  "productName": "NetWorkKing Beta",
  "version": "3.8.0-beta.1",
  "description": "NetWorkKing — network documentation: building structure, topology, Port Map, racks, fiber, CCTV and Wi-Fi in one app",
  "author": "Ulvi Badalov",
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.ulveelives.networkking.beta",
    "productName": "NetWorkKing Beta",
    "files": [
      "index.html",
      "main.js",
      "fx.html",
      "fxpreload.js",
      "preload.js",
      "css/**",
      "js/**",
      "icons/**",
      "vendor/**",
      "build/icon.png",
      "manifest.webmanifest",
      "LICENSE",
      "legal/**",
      "!build.bat"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "NetWorkKing-Beta-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NetWorkKing Beta",
      "license": "build/eula.txt"
    },
    "copyright": "© 2026 Ulvi Badalov. All rights reserved."
  }
}
